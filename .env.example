# ==============================================================================
# MergeMind Environment Configuration Template (.env.example)
# Copy to .env and configure local secrets. Never commit .env to version control.
# ==============================================================================

# Application Environment
PROJECT_NAME=MergeMind
VERSION=0.1.0
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
DEBUG=true

# Database Persistence
# For Docker / Local PostgreSQL:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mergemind
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/mergemind
# For Local Development without PostgreSQL installed:
# DATABASE_URL=sqlite+aiosqlite:///./mergemind.db
# DATABASE_SYNC_URL=sqlite:///./mergemind.db
DB_ECHO_SQL=false

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# GitHub App Integration
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_PATH=./keys/github-app-private-key.pem
GITHUB_WEBHOOK_SECRET=your_hmac_webhook_secret_here

# Execution Sandbox Configuration
# Set to 'container' if Docker daemon is active; set to 'disabled' to enforce fail-closed
SANDBOX_TYPE=container
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_CPU_QUOTA=1.0

# Quality Assessment & Gate Policy
SCORING_POLICY_VERSION=v1.0

# Frontend Configuration
VITE_API_URL=http://localhost:8000

