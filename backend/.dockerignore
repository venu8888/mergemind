# ==============================================================================
# MergeMind Backend Docker Build Context Exclusions (.dockerignore)
# ==============================================================================

# Secrets and keys (CRITICAL)
**/*.pem
**/*.key
**/*.crt
**/*.cer
keys/
.env*
!.env.example

# Python runtime artifacts & caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.db
*.sqlite3
